# Secret for /api/health — set any strong random value to unlock full health details.
# Without this, the endpoint returns only { ok: true } to anonymous callers.
HEALTH_SECRET=
# Stripe — leave empty to run without billing features (graceful degradation)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Cron secret — protects /api/cron/* routes. Generate: openssl rand -hex 32
# Set the same value in Vercel → Project → Settings → Environment Variables
CRON_SECRET=
