NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=RentalOS
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
ADMIN_EMAIL=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_BUSINESS_NAME=RentalOS
NEXT_PUBLIC_BUSINESS_PHONE=
