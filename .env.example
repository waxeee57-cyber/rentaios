NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=RentalOS
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
ADMIN_EMAIL=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_BUSINESS_NAME=RentalOS
NEXT_PUBLIC_BUSINESS_TAGLINE=Your rental business, automated.
NEXT_PUBLIC_GUMROAD_URL=
# Gumroad seller ID — found in Gumroad Settings → Advanced
GUMROAD_SELLER_ID=
# Anthropic API key — for Claude-powered cold email personalisation
ANTHROPIC_API_KEY=
# Apollo.io API key — for lead sourcing (free tier: 50 leads/mo)
APOLLO_API_KEY=
# Instantly.ai API key — for cold email delivery and domain warming
INSTANTLY_API_KEY=
NEXT_PUBLIC_BUSINESS_PHONE=
NEXT_PUBLIC_BUSINESS_WHATSAPP=
MAINTENANCE_MODE=false
# Secret for /api/health — set any strong random value to unlock full health details.
HEALTH_SECRET=
# Stripe — leave empty to run without billing features (graceful degradation)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_GROWTH_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_STARTER_ANNUAL_PRICE_ID=
STRIPE_GROWTH_ANNUAL_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Cron secret — protects /api/cron/* routes. Generate: openssl rand -hex 32
CRON_SECRET=
# Currency display on /pricing (display only, billing is always EUR)
NEXT_PUBLIC_AED_RATE=4.1
# Twilio — optional, enables SMS notifications add-on
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Monitoring / Ops (Blok 1) ────────────────────────────────────────────
# Domrol Ops cross-tenant status route (/api/ops/status). Unset = route 404s.
OPS_SECRET=
# Optional JSON registry of OTHER tenant deployments to monitor remotely:
# OPS_TENANTS=[{"slug":"costasol","url":"https://costasol.vercel.app","healthSecret":"..."}]
OPS_TENANTS=
# Alert delivery. If set, alerts POST here (Slack/Discord/n8n incoming webhook).
ALERT_WEBHOOK_URL=
# Or send alerts via the configured Resend client to ADMIN_EMAIL (opt-in).
ALERT_EMAIL_ENABLED=false

# ── Sentry error tracking (Blok 1) ───────────────────────────────────────
# PLACEHOLDER ONLY. Leave empty to keep Sentry fully inert (no events sent).
# Set to the real DSN from sentry.io to activate. Server + client are separate
# so the browser only ever sees the NEXT_PUBLIC_ value.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENV=
NEXT_PUBLIC_SENTRY_ENV=
# Release tag — Vercel sets VERCEL_GIT_COMMIT_SHA automatically on server.
SENTRY_RELEASE=
NEXT_PUBLIC_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
