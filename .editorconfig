# EditorConfig — https://editorconfig.org
# Enforces UTF-8 across the repo so a Windows editor can never silently save a
# file as cp1252/Latin-1 and reintroduce mojibake (double-encoded € / —).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
